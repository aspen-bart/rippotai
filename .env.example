NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Lokaal: SQLite.
DATABASE_URL="file:./dev.db"
# Productie / Netlify: PostgreSQL (bv. Neon of Netlify DB). Met een postgres-URL kiest scripts/prisma.mjs
# automatisch PostgreSQL. Gebruik bij Neon de gepoolde URL voor DATABASE_URL en de directe URL voor DIRECT_URL.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Minimaal 32 willekeurige tekens
AUTH_SECRET=
# Eerste beheerder (alleen gebruikt door `npm run db:seed`)
ADMIN_EMAIL=admin@rippotai.it
ADMIN_PASSWORD=
